# Sri Krishna Textile Billing - Environment Configuration Template

# Server Port (Injected automatically by Render / Railway)
PORT=3000

# Application Authentication Credentials (Required for Production Access)
APP_USERNAME=your_username
APP_PASSWORD=your_secure_password
SESSION_SECRET=your_random_session_secret_hex_or_string

# Database Storage Directory (Optional, defaults to ./data)
# Set to /app/data on Railway Volume or /var/data on Render Disk
DATA_DIR=
